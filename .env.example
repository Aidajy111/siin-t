# Ports published on the host.
APP_PORT=8080
POSTGRES_PORT=5432

# Application settings.
BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=10s
# Keep this longer than HTTP_SHUTDOWN_TIMEOUT.
STOP_GRACE_PERIOD=15s

# Local PostgreSQL settings. Compose overrides the host and internal port.
POSTGRES_HOST=localhost
POSTGRES_DB=siin
POSTGRES_USER=siin
POSTGRES_PASSWORD=siin_local_password
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_MAX_CONNS=10
